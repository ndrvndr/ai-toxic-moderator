{
  "name": "ai-toxic-moderator",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run format:check",
    "test": "node --experimental-test-isolation=none --test tests/contracts.test.cjs tests/config.test.cjs",
    "test:db": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/database.test.cjs",
    "test:auth": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/auth.test.cjs",
    "test:google": "node --experimental-test-isolation=none --test tests/google.test.cjs",
    "test:monitoring-schema": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/monitoring-schema.test.cjs",
    "test:monitoring-unit": "node --experimental-test-isolation=none --test tests/youtube-monitoring.test.cjs tests/monitoring-contracts.test.cjs",
    "test:google-service": "node --experimental-test-isolation=none --test tests/google-service.test.cjs",
    "test:youtube-session": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/youtube-session.test.cjs",
    "test:monitoring-start": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/monitoring-start.test.cjs",
    "test:monitoring-http": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/monitoring-http.test.cjs",
    "test:ingestion-schema": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/ingestion-schema.test.cjs",
    "test:migration-checksum": "node --experimental-test-isolation=none --test tests/migration-checksum.test.cjs",
    "test:worker-lease": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/worker-lease.test.cjs",
    "test:chat-observation-schema": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/chat-observation-schema.test.cjs",
    "test:youtube-chat-adapter": "node --experimental-test-isolation=none --test tests/youtube-chat-adapter.test.cjs",
    "test:worker-runtime": "node --experimental-test-isolation=none --test tests/worker-runtime.test.cjs",
    "test:ingestion-integration": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/ingestion-integration.test.cjs",
    "test:live-event-feed": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/live-event-feed.test.cjs",
    "test:live-websocket": "node --experimental-test-isolation=none --test tests/live-websocket.test.cjs",
    "test:live-event-protocol": "node --experimental-test-isolation=none --test tests/live-event-protocol.test.cjs",
    "test:live-hooks": "npm run test:live-hooks --workspace @moderator/dashboard",
    "test:moderation-core": "node --experimental-test-isolation=none --test tests/moderation-core.test.cjs",
    "test:moderation-policy": "node --experimental-test-isolation=none --test tests/moderation-policy.test.cjs",
    "test:classification-schema": "node --env-file-if-exists=.env --experimental-test-isolation=none --test tests/classification-schema.test.cjs",
    "test:classification-store": "node --experimental-test-isolation=none --test tests/classification-store.test.cjs",
    "test:moderation-action-contracts": "node --experimental-test-isolation=none --test tests/moderation-action-contracts.test.cjs",
    "test:action-planner": "node --experimental-test-isolation=none --test tests/action-planner.test.cjs",
    "test:action-plan-store": "node --experimental-test-isolation=none --test tests/action-plan-store.test.cjs",
    "dev:api": "npm run build:core && npm run build --workspace=@moderator/api && node --env-file-if-exists=.env apps/api/dist/main.js",
    "dev:worker": "npm run build:core && npm run build --workspace=@moderator/worker && node --env-file-if-exists=.env apps/worker/dist/main.js",
    "dev:dashboard": "npm run dev --workspace=@moderator/dashboard",
    "build:core": "node scripts/build.mjs --core",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/database.mjs seed",
    "db:runtime": "node --env-file-if-exists=.env scripts/runtime-role.mjs",
    "db:worker": "node --env-file-if-exists=.env scripts/worker-role.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "node scripts/organize-imports.mjs && prettier --write .",
    "format:check": "node scripts/organize-imports.mjs --check && prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "prettier": "3.6.2"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
