{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./apps/dashboard/*"],
      "@moderator/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "apps/**/*.mts", "packages/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/.next"]
}
