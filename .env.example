NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://moderator:local_demo_only@127.0.0.1:55432/moderator

REDIS_HOST=127.0.0.1
REDIS_PORT=56379
WORKER_ENABLED=false

DEV_AUTH_ENABLED=false
DEV_ACCOUNT_ID=10000000-0000-4000-8000-000000000001

DASHBOARD_ORIGIN=http://127.0.0.1:3000
SESSION_TTL_SECONDS=3600

# Google OAuth (backend only). Enable after setting credentials and applying migration 003.
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/v1/auth/google/callback

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Optional: separate migration/admin connection from the API runtime connection.
# MIGRATION_DATABASE_URL=postgresql://moderator:local_demo_only@127.0.0.1:55432/moderator
# RUNTIME_DB_ROLE=moderator_api
# RUNTIME_DB_PASSWORD=set-a-local-password-of-at-least-16-characters
