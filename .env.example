# Local development template. Copy to .env and replace every CHANGE_ME placeholder.
# Keep real credentials in .env only; this example is committed to Git.
# Setup: start Compose, configure owner credentials and role passwords, then run
# npm run db:migrate, npm run db:runtime, and npm run db:worker.
# URLs do not automatically expand other environment variables.
# URL-encode passwords in URLs; provisioning password variables use raw values.

# Application: supported modes are development and test, not production.
NODE_ENV=development
# Local HTTP port for the NestJS API.
API_PORT=3001
# API runtime: use the unprivileged role, not the database owner.
# Replace the URL password with the URL-encoded RUNTIME_DB_PASSWORD value.
DATABASE_URL=postgresql://moderator_api:CHANGE_ME_API_PASSWORD@127.0.0.1:55432/moderator

# Redis: host port must match compose.yaml; the container still uses 6379.
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
# Enable after worker role provisioning and Google OAuth configuration.
# This flag allows execution; start the process with npm run dev:worker.
WORKER_ENABLED=false

# Automatic AI: discovers one active run with captured enabled AI Settings.
# Requires worker, Google OAuth, and the pinned local model revision below.
# Leave AI_SHADOW_ENABLED=false and AI_SHADOW_RUN_ID empty in automatic mode.
# Start the worker once; successive eligible runs do not need a config edit/restart.
# Real actions still require captured thresholds and the YouTube executor switches.
AI_AUTOMATIC_ENABLED=false

# Optional manually scoped AI mode for testing one active or saved run.
# Mutually exclusive with AI_AUTOMATIC_ENABLED; requires WORKER_ENABLED=true.
# Stores model output and audits; enabled captured Settings can also plan actions.
# To observe without enforcement, disable captured automatic AI Settings or executors.
# To enable: fill the run ID and revision below, set true, and restart the worker.
AI_SHADOW_ENABLED=false
# Internal monitoring run UUID from the monitoring API response (not session ID).
# Use run.id, not run.session_id or the YouTube broadcast ID.
# Only messages first observed in this run are evaluated, including stored messages.
# A STOPPED run with stored text can be used for verification.
# Shadow inference makes no YouTube requests; active ingestion still consumes quota.
# Manual mode only: change this value and restart to evaluate another run.
AI_SHADOW_RUN_ID=
# Shared by automatic and manual AI modes. Exact 40-character revision from
# .cache/ai-prototype/manifest.json (the revision value, not the file path).
# Must match the local artifacts; no model downloads happen inside the worker.
# Copy the actual local revision instead of using a branch name such as main.
AI_SHADOW_MODEL_REVISION=
# Relative to the working directory when starting the worker from the repo root.
AI_SHADOW_CACHE_DIRECTORY=.cache/ai-prototype
# Child startup and per-message inference deadlines in milliseconds (1-300000).
AI_SHADOW_STARTUP_TIMEOUT_MS=30000
AI_SHADOW_INFERENCE_TIMEOUT_MS=5000

# Automatic message deletion: real requests require worker and Google auth enabled.
YOUTUBE_DELETE_ENABLED=false
# Optional controlled test: fill BOTH values, or leave BOTH empty.
# Session is the internal UUID; author is the test viewer's YouTube channel ID.
YOUTUBE_DELETE_TEST_SESSION_ID=
YOUTUBE_DELETE_TEST_AUTHOR_ID=

# Automatic timeout/ban: real requests require worker and Google auth enabled.
YOUTUBE_BAN_ENABLED=false
# Optional controlled test: fill ALL three values, or leave ALL three empty.
# Session is the internal UUID; author is the test viewer's YouTube channel ID.
# Do not enable controlled deletion and controlled author moderation together.
YOUTUBE_BAN_TEST_SESSION_ID=
YOUTUBE_BAN_TEST_AUTHOR_ID=
# Use TIMEOUT or BAN when the controlled test is configured.
YOUTUBE_BAN_TEST_ACTION=

# Optional local development login using an existing seeded account.
DEV_AUTH_ENABLED=false
DEV_ACCOUNT_ID=10000000-0000-4000-8000-000000000001

# Exact browser origin without a trailing slash; use one hostname consistently.
DASHBOARD_ORIGIN=http://127.0.0.1:3000
# Dashboard session lifetime in seconds (60-86400).
SESSION_TTL_SECONDS=3600

# Google OAuth (backend only). Enable after migrations and credential setup.
# Both credentials and TOKEN_ENCRYPTION_KEY are required when enabled.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorized Google Cloud redirect URI exactly.
# Must also use the dashboard hostname and API_PORT configured above.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/v1/auth/google/callback

# Encrypts persisted Google tokens. Use the same key for API and worker.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required: 64 hexadecimal characters. Replacing it makes existing tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# Local integration-test database connection. Requires schema-creation permissions.
# Tests that provision temporary roles also require role-management permissions.
# Leave empty until running database integration tests.
TEST_DATABASE_URL=

# Dedicated unprivileged PostgreSQL role for the worker.
WORKER_DB_ROLE=moderator_worker
# Set at least 16 characters before running npm run db:worker.
WORKER_DB_PASSWORD=
# Replace the URL password with the URL-encoded WORKER_DB_PASSWORD value.
WORKER_DATABASE_URL=postgresql://moderator_worker:CHANGE_ME_WORKER_PASSWORD@127.0.0.1:55432/moderator

# Database owner connection for migrations, role provisioning and local fixture seed.
# Use the existing owner's credentials; do not use this URL for API or worker runtime.
# Changing POSTGRES_PASSWORD in Compose does not reset an existing database password.
MIGRATION_DATABASE_URL=postgresql://moderator:CHANGE_ME_OWNER_PASSWORD@127.0.0.1:55432/moderator

# Dedicated unprivileged API role. Must match the username in DATABASE_URL.
RUNTIME_DB_ROLE=moderator_api
# Set at least 16 characters before running npm run db:runtime.
RUNTIME_DB_PASSWORD=
